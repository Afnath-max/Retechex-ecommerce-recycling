# Server Configuration
NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=mongodb://localhost:27017/retechex

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Email Configuration (Gmail, Brevo, or another SMTP provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM="ReTechEx" <noreply@retechex.com>

# Optional admin key for /api/admin/discounts/bulk
ADMIN_SECRET=

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Admin Account (First time setup)
ADMIN_EMAIL=admin@retechex.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=System Admin
